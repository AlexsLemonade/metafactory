/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run AlexsLemonade/metafactory -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [cpus: 4, memory: '15.GB', time: '1.h']
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input                      = "${projectDir}/tests/assets/samplesheet.csv"
    outdir                     = "${projectDir}/tests/results"

    // reduced settings so the test runs quickly on GitHub runners
    // fewer permutation replicates than the default of 1000
    nreps                      = 10

    // test two values of k in cNMF (5 and 10) rather than the default of three
    cnmf_k_lower               = 5
    cnmf_k_upper               = 10
    cnmf_k_step_size           = 5

    // at least four values are required to choose the optimal value of k
    n_metaprograms             = '4,5,6,7'
}

outputDir = params.outdir

aws {
    client.anonymous = true
}
