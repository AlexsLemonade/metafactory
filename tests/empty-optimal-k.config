/*
========================================================================================
    Nextflow config file for the empty optimal k test in tests/stub.nf.test
========================================================================================
    Makes the CALCULATE_K stub write an empty optimal k file, as if no value of k could be
    chosen for a group, so the pipeline should fail before rendering any report.
*/

process {
    withName: 'CALCULATE_K' {
        ext.stub_optimal_k = ''
    }
}
