/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Cap resource requests so that every process fits on a standard GitHub runner
// (e.g. process_high_memory requests 200 GB by default)
process {
    resourceLimits = [cpus: 4, memory: '15.GB', time: '1.h']
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
