// the h5ad paths in the stub samplesheet are relative to the project directory, but nf-test
// launches each test from its own directory, so a copy of the samplesheet with absolute paths is
// written to the test's directory (the parent of outputDir), which keeps it out of the output
// directory that is snapshotted
// the stub samplesheet points at placeholder h5ad files in stub/data, which is not committed, so
// empty placeholders are created here. stub modules do not read them, but they must exist to pass
// samplesheet validation. the when block runs in full before the pipeline is launched, so these
// files exist when the pipeline starts
def writeStubSamplesheet = { output_dir, project_dir ->
    def stub_samplesheet = new File(new File(output_dir.toString()).parent, 'stub-samplesheet.csv')

    def stub_lines = new File("${project_dir}/stub/samplesheet.csv").readLines()
    stub_lines.drop(1).each { line ->
        def h5ad_file = new File("${project_dir}/${line.tokenize(',')[-1]}")
        h5ad_file.parentFile.mkdirs()
        h5ad_file.createNewFile()
    }

    stub_samplesheet.parentFile.mkdirs()
    stub_samplesheet.text = stub_lines.join('\n')
        .replace('stub/data/', "${project_dir}/stub/data/")
    stub_samplesheet
}

nextflow_pipeline {

    name "Test pipeline stub"
    script "../main.nf"
    tag "pipeline"
    tag "stub"

    // runs the stub block of every module, which checks the channel wiring between modules
    // without running any analysis
    options "-stub"

    test("-profile test -stub") {

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            // nf-core lint looks for `outdir = "$outputDir"` in the when block and treats the first
            // closing brace as the end of the block, so the params block comes before any code with braces
            params {
                outdir = "$outputDir"
                input  = stub_samplesheet.toString()
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: stub outputs are empty files (or hold a fixed value), so every file
            // outside of pipeline_info has stable content
            // each file is recorded as `<path relative to outdir>:md5,<checksum>`, so the snapshot holds
            // no paths from the machine the test ran on and files with the same name in different
            // directories can be told apart. the md5 is taken from the raw file bytes, because the
            // nf-test md5 helper decompresses .gz files and the stub .gz outputs are empty, not valid gzip
            def outdir_path = new File(params.outdir).toPath()
            def stable_content = getAllFilesFromDir(params.outdir, ignore: ['pipeline_info/*'])
                .collect { f -> "${outdir_path.relativize(f.toPath())}:md5,${java.security.MessageDigest.getInstance('MD5').digest(f.bytes).encodeHex()}".toString() }
                .sort()

            assert workflow.success
            assertAll(
                { assert snapshot(
                    // number of tasks that ran, which changes if a channel drops or duplicates items
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("${params.outdir}/pipeline_info/metafactory_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    test("-profile test -stub fails when no optimal k is found") {

        // makes the CALCULATE_K stub write an empty optimal k file for every group
        config "./empty-optimal-k.config"

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            params {
                outdir = "$outputDir"
                input  = stub_samplesheet.toString()
            }
        }

        then {
            assert workflow.failed
            // the message names whichever group fails first, so the group is not checked
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assert output.contains('Cannot find the optimal value of k for group')
            assert output.contains('optimal-k.txt is empty')
            // only the individual report depends on the validated optimal-k channel
            assert !workflow.trace.succeeded()*.name.any { name -> name.contains('RENDER_INDIVIDUAL_REPORT') }
        }
    }

    // the tests below check when existing cNMF and metaprogram checkpoints are reused. each writes
    // checkpoints into its output directory before the pipeline starts, as an earlier run with the
    // same --outdir would have, and checks which CNMF and GENERATE_METAPROGRAMS tasks ran. the
    // helpers, and the options the checkpoints are written with, are in
    // tests/lib/CheckpointTestUtils.groovy. existing cNMF checkpoints record the cnmf_run_id
    // `previous-run` and the CNMF stub writes `stub`, so any library whose cNMF runs gets a new run id

    test("-profile test -stub --reuse_metaprograms reuses matching checkpoints and rebuilds the rest") {

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            params {
                outdir             = "$outputDir"
                input              = stub_samplesheet.toString()
                reuse_metaprograms = true
            }

            CheckpointTestUtils.writeAllCheckpoints(outputDir)
            // GROUP01: cNMF matches for both libraries. k-4 matches, k-5 was built from an earlier
            // cNMF run (e.g. a --repeat_cnmf run that stopped before rebuilding it), k-6 is missing a
            // results file, and k-7 was built with different options
            CheckpointTestUtils.writeMetaprogramCheckpoint(outputDir, 'GROUP01', 5, [cnmf_run_ids: ['older-run', 'older-run']])
            CheckpointTestUtils.writeMetaprogramCheckpoint(outputDir, 'GROUP01', 6, [:], ['shuffled_metaprograms.tsv.gz'])
            CheckpointTestUtils.writeMetaprogramCheckpoint(outputDir, 'GROUP01', 7, [nreps: 1000])
            // GROUP02: STUB03 was run with a different seed, so its cNMF runs again with a new run id
            CheckpointTestUtils.writeCnmfCheckpoint(outputDir, 'STUB03', [seed: 1])
        }

        then {
            assert workflow.success
            assertAll(
                { assert CheckpointTestUtils.tasksRun(workflow, 'CNMF') == ['STUB03'] },
                // every GROUP02 set is rebuilt because STUB03 has a new cNMF run id
                { assert CheckpointTestUtils.tasksRun(workflow, 'GENERATE_METAPROGRAMS') == ['GROUP01-k5', 'GROUP01-k6', 'GROUP01-k7'] + CheckpointTestUtils.allMetaprogramTasks('GROUP02') },
                // the reused checkpoints are passed on to the rest of the pipeline
                { assert CheckpointTestUtils.tasksRun(workflow, 'CALCULATE_K') == ['GROUP01', 'GROUP02'] },
            )
        }
    }

    test("-profile test -stub --reuse_metaprograms reruns checkpoints that record an option the current run does not set") {

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            params {
                outdir             = "$outputDir"
                input              = stub_samplesheet.toString()
                reuse_metaprograms = true
            }

            CheckpointTestUtils.writeAllCheckpoints(outputDir)
            // as if each checkpoint was created by a version of the pipeline with an option that has
            // since been removed: cNMF for STUB01, and the GROUP02 k-4 metaprograms
            CheckpointTestUtils.writeCnmfCheckpoint(outputDir, 'STUB01', [removed_option: 1])
            CheckpointTestUtils.writeMetaprogramCheckpoint(outputDir, 'GROUP02', 4, [removed_option: 1])
        }

        then {
            assert workflow.success
            assertAll(
                { assert CheckpointTestUtils.tasksRun(workflow, 'CNMF') == ['STUB01'] },
                // every GROUP01 set is rebuilt because STUB01 has a new cNMF run id
                { assert CheckpointTestUtils.tasksRun(workflow, 'GENERATE_METAPROGRAMS') == CheckpointTestUtils.allMetaprogramTasks('GROUP01') + ['GROUP02-k4'] },
            )
        }
    }

    test("-profile test -stub --reuse_metaprograms reuses metaprograms built from cNMF results without a run id until cNMF runs again") {

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            params {
                outdir             = "$outputDir"
                input              = stub_samplesheet.toString()
                reuse_metaprograms = true
            }

            // checkpoints from before run ids were recorded: no cNMF checkpoint has a cnmf_run_id
            CheckpointTestUtils.GROUPS.values().flatten().each { unique_id ->
                CheckpointTestUtils.writeCnmfCheckpoint(outputDir, unique_id, [cnmf_run_id: null])
            }
            // GROUP01 metaprograms were rebuilt after run ids were added, so they record null run ids
            // GROUP02 metaprograms were built before, so they have no cnmf_run_ids at all
            CheckpointTestUtils.N_METAPROGRAMS.each { n_metaprograms ->
                CheckpointTestUtils.writeMetaprogramCheckpoint(outputDir, 'GROUP01', n_metaprograms, [cnmf_run_ids: [null, null]])
                CheckpointTestUtils.writeMetaprogramCheckpoint(outputDir, 'GROUP02', n_metaprograms, [cnmf_run_ids: null])
            }
        }

        then {
            assert workflow.success
            assertAll(
                // a missing cnmf_run_id is not compared when deciding whether to run cNMF
                { assert CheckpointTestUtils.tasksRun(workflow, 'CNMF') == [] },
                { assert CheckpointTestUtils.tasksRun(workflow, 'GENERATE_METAPROGRAMS') == CheckpointTestUtils.allMetaprogramTasks('GROUP02') },
            )
        }
    }

    test("-profile test -stub --repeat_cnmf --reuse_metaprograms runs cNMF and rebuilds metaprograms for every library") {

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            params {
                outdir             = "$outputDir"
                input              = stub_samplesheet.toString()
                repeat_cnmf        = true
                reuse_metaprograms = true
            }

            CheckpointTestUtils.writeAllCheckpoints(outputDir)
        }

        then {
            assert workflow.success
            assertAll(
                { assert CheckpointTestUtils.tasksRun(workflow, 'CNMF') == ['STUB01', 'STUB02', 'STUB03', 'STUB04'] },
                { assert CheckpointTestUtils.tasksRun(workflow, 'GENERATE_METAPROGRAMS') == CheckpointTestUtils.allMetaprogramTasks('GROUP01') + CheckpointTestUtils.allMetaprogramTasks('GROUP02') },
            )
        }
    }

    test("-profile test -stub rebuilds every metaprogram set without running cNMF by default") {

        when {
            def stub_samplesheet = writeStubSamplesheet(outputDir, projectDir)

            params {
                outdir = "$outputDir"
                input  = stub_samplesheet.toString()
            }

            CheckpointTestUtils.writeAllCheckpoints(outputDir)
        }

        then {
            assert workflow.success
            assertAll(
                { assert CheckpointTestUtils.tasksRun(workflow, 'CNMF') == [] },
                { assert CheckpointTestUtils.tasksRun(workflow, 'GENERATE_METAPROGRAMS') == CheckpointTestUtils.allMetaprogramTasks('GROUP01') + CheckpointTestUtils.allMetaprogramTasks('GROUP02') },
            )
        }
    }
}
