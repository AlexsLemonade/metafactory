nextflow_pipeline {

    name "Test pipeline stub"
    script "../main.nf"
    tag "pipeline"
    tag "stub"

    // runs the stub block of every module, which checks the channel wiring between modules
    // without running any analysis
    options "-stub"

    test("-profile test -stub") {

        when {
            params {
                // the stub samplesheet points at placeholder h5ad files in stub/data, which is not
                // committed, so empty placeholders are created here. stub modules do not read them,
                // but they must exist to pass samplesheet validation
                def stub_lines = new File("${projectDir}/stub/samplesheet.csv").readLines()
                stub_lines.drop(1).each { line ->
                    def h5ad_file = new File("${projectDir}/${line.tokenize(',')[-1]}")
                    h5ad_file.parentFile.mkdirs()
                    h5ad_file.createNewFile()
                }

                // the h5ad paths in the stub samplesheet are relative to the project directory,
                // but nf-test launches each test from its own directory, so a copy of the
                // samplesheet with absolute paths is written to the test output directory
                def stub_samplesheet = new File("${outputDir}/stub-samplesheet.csv")
                stub_samplesheet.parentFile.mkdirs()
                stub_samplesheet.text = stub_lines.join('\n')
                    .replace('stub/data/', "${projectDir}/stub/data/")

                input  = stub_samplesheet.toString()
                outdir = "$outputDir/results"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: stub outputs are empty files (or hold a fixed value), so every file
            // outside of pipeline_info has stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignore: ['pipeline_info/*'])

            assert workflow.success
            assertAll(
                { assert snapshot(
                    // number of tasks that ran, which changes if a channel drops or duplicates items
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("${params.outdir}/pipeline_info/metafactory_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
