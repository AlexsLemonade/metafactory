// Tests for the GENERATE_REPORTS subworkflow.
//
// The tests tagged "stub" check the channel wiring. They run in stub mode, so no report is
// rendered and the inputs are empty placeholder files. Each of these tests describes its input as a
// design map of group_id -> [optimal_k: k], where k is the value of k chosen for that group. The
// helpers below build the subworkflow input and the expected results from the same design.
//
// The other tests render both reports from the outputs of a real run of the pipeline with the test
// profile, which are saved in `tests/data/` at the root of the repository and shared with the
// CALCULATE_METRICS tests. To regenerate these files, for example after the output of a module
// upstream of the reports changes, run `tests/scripts/update-test-data.sh`.
//
// Helpers shared with the other subworkflow tests are in `tests/lib/SubworkflowTestUtils.groovy`.

// the report metrics tables written by the calculate k module for every group
def reportMetricsSuffixes = [
    'all-k_metaprogram_metrics.tsv',
    'all-k_summary_metrics.tsv',
    'all-k_background_eff_sample_size.tsv.gz',
    'all-k_background_geneset_specificity.tsv.gz',
    'all-k_background_cell_score_cv.tsv.gz',
]

// the files for the metaprogram set chosen as the optimal value of k, in input order
def optimalSetSuffixes = [
    'metaprograms.rds',
    'metaprogram_metrics.tsv',
    'ora_results.tsv',
    'geneset_metrics.tsv',
    'combined_metaprogram_scores.tsv.gz',
]

// Nextflow code for the three subworkflow inputs. path inputs must exist to be staged, so an empty
// placeholder is created for every file in a temporary directory
// every file name holds its group (and k), so the files staged into each task show which
// group's inputs that task received.
// with reverse_optimal_k, the optimal k channel lists the groups in reverse order, so the join
// can only pair the channels correctly by matching the meta, not by position
def generateReportsInput = { design, reverse_optimal_k = false ->
    def input_dir = File.createTempDir()
    def placeholder = { name ->
        def placeholder_file = new File(input_dir, name)
        placeholder_file.createNewFile()
        "file('${placeholder_file}')"
    }
    def optimal_k = design.collect { group_id, group ->
        def optimal_k_file = new File(input_dir, "${group_id}_optimal-k.txt")
        optimal_k_file.text = "${group.optimal_k}\n"
        "[[group_id: '${group_id}'], file('${optimal_k_file}')]"
    }
    if (reverse_optimal_k) {
        optimal_k = optimal_k.reverse()
    }
    def report_metrics = design.collect { group_id, _group ->
        def files = reportMetricsSuffixes.collect { suffix -> placeholder("${group_id}_${suffix}") }
        "[[group_id: '${group_id}'], ${files.join(', ')}]"
    }
    def optimal_sets = design.collect { group_id, group ->
        def files = optimalSetSuffixes.collect { suffix -> placeholder("${group_id}_k-${group.optimal_k}_${suffix}") }
        "[[group_id: '${group_id}', optimal_k: ${group.optimal_k}], ${files.join(', ')}]"
    }
    """
    input[0] = channel.of(${optimal_k.join(', ')})
    input[1] = channel.of(${report_metrics.join(', ')})
    input[2] = channel.of(${optimal_sets.join(', ')})
    """
}

// identifies a task from its meta: the group, plus the optimal k for the individual report
def taskId = { meta ->
    (meta.containsKey('optimal_k') ? "${meta.group_id}/k-${meta.optimal_k}" : meta.group_id).toString()
}

// the emitted items for each process. each task emits one item, and the meta in that item is
// the meta the task ran with
def taskEmits = { out ->
    [
        RENDER_INDIVIDUAL_REPORT: out.individual_report,
        RENDER_METRICS_REPORT: out.metrics_report,
    ]
}

// the task metas expected from a design: one metrics report and one individual report per group,
// each with the input meta passed through unchanged
def expectedTaskMetas = { design ->
    [
        RENDER_INDIVIDUAL_REPORT: design.collect { group_id, group -> [group_id: group_id, optimal_k: group.optimal_k] }
            .sort { meta -> taskId(meta) },
        RENDER_METRICS_REPORT: design.collect { group_id, _group -> [group_id: group_id] }
            .sort { meta -> taskId(meta) },
    ]
}

// checks that each report is named as in meta.yml inside a directory named for the group
def checkOutputs = { out ->
    out.metrics_report.each { meta, path ->
        assert path.toString().endsWith("/${meta.group_id}/combined-metaprogram-metrics.html")
    }
    out.individual_report.each { meta, path ->
        assert path.toString().endsWith("/${meta.group_id}/individual-metaprogram-evaluation.html")
    }
}

// the task directory of an emitted item, for SubworkflowTestUtils.stagedInputs. each report is
// written to a directory named for the group inside the task directory, so the task directory is
// found by going up from the report
def taskDir = { _meta, path ->
    new File(path.toString()).parentFile.parentFile
}

// the file names a task should stage, worked out from its process and meta
def expectedStagedInputs = { task, design ->
    def meta = task.meta
    def files = ['report/report.rmd']
    if (task.process == 'RENDER_METRICS_REPORT') {
        // every report metrics table for the group, and the group's own optimal k file
        files += reportMetricsSuffixes.collect { suffix -> "${meta.group_id}_${suffix}" }
        files << "${meta.group_id}_optimal-k.txt"
    }
    else {
        // the files for the optimal metaprogram set, except the gene set metrics table, which
        // the individual report does not read
        files += (optimalSetSuffixes - 'geneset_metrics.tsv').collect { suffix -> "${meta.group_id}_k-${meta.optimal_k}_${suffix}" }
    }
    files*.toString().sort()
}

// Nextflow code for the three subworkflow inputs, using the pipeline outputs in `tests/data/`.
// modify argument maps the name of an input file to a closure that takes the lines of that file and returns
// the lines to use in their place, so that a test can change an input to check an edge case. the
// name is the file name in `tests/data/` without the `k-<optimal k>_` prefix of the files for the
// optimal metaprogram set, e.g. `ora_results.tsv`. only uncompressed files can be modified. modified
// files are written to a temporary directory, so the files in `tests/data/` are never changed
def renderReportsInput = { data_dir, modify = [:] ->
    def optimal_k = SubworkflowTestUtils.dataOptimalK(data_dir)
    def modified_dir = File.createTempDir()
    def inputFile = { name, data_name ->
        def input_file = new File(data_dir, data_name)
        if (modify.containsKey(name)) {
            input_file = SubworkflowTestUtils.modifiedFile(input_file, modify[name], modified_dir)
        }
        "file('${input_file}')"
    }
    def report_metrics = reportMetricsSuffixes.collect { name -> inputFile(name, "reports/${name}") }
    def optimal_set = ['metaprograms.rds', 'mp_metrics.tsv', 'ora_results.tsv', 'geneset_metrics.tsv', 'combined_metaprogram_scores.tsv.gz']
        .collect { name -> inputFile(name, "k-${optimal_k}_${name}") }
    """
    input[0] = channel.of([[group_id: '${SubworkflowTestUtils.DATA_GROUP_ID}'], ${inputFile('optimal-k.txt', 'optimal-k.txt')}])
    input[1] = channel.of([[group_id: '${SubworkflowTestUtils.DATA_GROUP_ID}'], ${report_metrics.join(', ')}])
    input[2] = channel.of([[group_id: '${SubworkflowTestUtils.DATA_GROUP_ID}', optimal_k: ${optimal_k}], ${optimal_set.join(', ')}])
    """
}

nextflow_workflow {

    name "Test subworkflow GENERATE_REPORTS"
    script "../main.nf"
    workflow "GENERATE_REPORTS"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "generate_reports"

    test("one group generates the expected outputs") {


        tag "stub"
        options "-stub"

        def design = [
            groupA: [optimal_k: 4],
        ]

        when {
            // nf-core lint looks for `outdir = "$outputDir"` in the when block and treats the first
            // closing brace as the end of the block, so the params block comes before any code with braces
            params {
                outdir = "$outputDir"
            }
            workflow {
                generateReportsInput(design)
            }
        }

        then {
            assert workflow.success
            // one metrics report and one individual report
            assert workflow.trace.succeeded().size() == 2
            assert SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId) == expectedTaskMetas(design)
            assert workflow.out.metrics_report.size() == 1
            assert workflow.out.individual_report.size() == 1
            checkOutputs(workflow.out)
            assert snapshot(
                SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId),
                SubworkflowTestUtils.outputSummary(workflow.out.metrics_report, taskId),
                SubworkflowTestUtils.outputSummary(workflow.out.individual_report, taskId),
            ).match()
        }
    }

    test("several groups with different optimal k") {

        tag "stub"
        options "-stub"

        def design = [
            groupA: [optimal_k: 4],
            groupB: [optimal_k: 6],
            groupC: [optimal_k: 5],
        ]

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                generateReportsInput(design)
            }
        }

        then {
            assert workflow.success
            def metas = SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId)
            assert metas == expectedTaskMetas(design)
            // each individual report carries its own group's optimal k
            assert metas.RENDER_INDIVIDUAL_REPORT.collect { meta -> [meta.group_id, meta.optimal_k] } ==
                [['groupA', 4], ['groupB', 6], ['groupC', 5]]
            assert workflow.out.metrics_report.size() == 3
            assert workflow.out.individual_report.size() == 3
            checkOutputs(workflow.out)
            assert snapshot(
                metas,
                SubworkflowTestUtils.outputSummary(workflow.out.metrics_report, taskId),
                SubworkflowTestUtils.outputSummary(workflow.out.individual_report, taskId),
            ).match()
        }
    }

    test("optimal k is joined to the report metrics by group, not by order") {

        tag "stub"
        options "-stub"

        def design = [
            groupA: [optimal_k: 4],
            groupB: [optimal_k: 6],
            groupC: [optimal_k: 5],
        ]

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                // the optimal k channel lists the groups in the reverse order of the report metrics
                generateReportsInput(design, true)
            }
        }

        then {
            assert workflow.success
            assert SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId) == expectedTaskMetas(design)
            // each metrics report stages its own group's optimal k file next to its own metrics tables
            def metrics_tasks = SubworkflowTestUtils.stagedInputs(taskEmits(workflow.out), taskDir).findAll { task -> task.process == 'RENDER_METRICS_REPORT' }
            assert metrics_tasks.size() == 3
            metrics_tasks.each { task ->
                assert task.staged == expectedStagedInputs(task, design) : "unexpected files staged for ${task.process} ${taskId(task.meta)}"
            }
            checkOutputs(workflow.out)
            assert snapshot(
                metrics_tasks
                    .collect { task -> "${task.process} ${taskId(task.meta)}: ${task.staged.join(', ')}".toString() }
                    .sort()
            ).match()
        }
    }

    test("output meta is passed through unchanged") {

        tag "stub"
        options "-stub"

        def design = [
            groupA: [optimal_k: 4],
            groupB: [optimal_k: 6],
        ]

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                generateReportsInput(design)
            }
        }

        then {
            assert workflow.success
            workflow.out.metrics_report.each { meta, _path ->
                assert meta.keySet() == ['group_id'] as Set
            }
            workflow.out.individual_report.each { meta, _path ->
                assert meta.keySet() == ['group_id', 'optimal_k'] as Set
                assert meta.optimal_k instanceof Integer
            }
            // also checks the meta values and the report paths for each group
            assert SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId) == expectedTaskMetas(design)
            checkOutputs(workflow.out)
            assert snapshot(
                SubworkflowTestUtils.outputSummary(workflow.out.metrics_report, taskId),
                SubworkflowTestUtils.outputSummary(workflow.out.individual_report, taskId),
            ).match()
        }
    }

    test("each process stages only the files it needs") {

        tag "stub"
        options "-stub"

        def design = [
            groupA: [optimal_k: 4],
            groupB: [optimal_k: 6],
        ]

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                generateReportsInput(design)
            }
        }

        then {
            assert workflow.success
            assert SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId) == expectedTaskMetas(design)
            def staged_tasks = SubworkflowTestUtils.stagedInputs(taskEmits(workflow.out), taskDir)
            // every task that ran emitted an item, so all of their staged inputs are checked
            assert staged_tasks.size() == workflow.trace.succeeded().size()
            // each task stages the files that match its meta, and nothing else. this also checks
            // that the gene set metrics table never reaches the individual report, and that the
            // report rmd is staged into the report subdirectory
            staged_tasks.each { task ->
                assert task.staged == expectedStagedInputs(task, design) : "unexpected files staged for ${task.process} ${taskId(task.meta)}"
            }
            assert snapshot(
                staged_tasks
                    .collect { task -> "${task.process} ${taskId(task.meta)}: ${task.staged.join(', ')}".toString() }
                    .sort()
            ).match()
        }
    }

    test("renders both reports from pipeline outputs") {

        tag "render"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                renderReportsInput(SubworkflowTestUtils.dataDir(baseDir))
            }
        }

        then {
            def optimal_k = SubworkflowTestUtils.dataOptimalK(SubworkflowTestUtils.dataDir(baseDir))
            assert workflow.success
            // one metrics report and one individual report
            assert workflow.trace.succeeded().size() == 2
            assert SubworkflowTestUtils.taskMetas(taskEmits(workflow.out), taskId) == expectedTaskMetas([(SubworkflowTestUtils.DATA_GROUP_ID): [optimal_k: optimal_k]])
            checkOutputs(workflow.out)
            // the rendered html is not stable between runs, so only the report names are recorded
            assert snapshot(
                SubworkflowTestUtils.outputSummary(workflow.out.metrics_report, taskId),
                SubworkflowTestUtils.outputSummary(workflow.out.individual_report, taskId),
            ).match()
        }
    }

    test("individual report renders with no ORA results") {

        tag "render"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                // keep only the header of the ORA results, as when no gene set is significant for
                // any metaprogram
                renderReportsInput(SubworkflowTestUtils.dataDir(baseDir), ['ora_results.tsv': { lines -> lines.take(1) }])
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.succeeded().size() == 2
            checkOutputs(workflow.out)
            assert snapshot(
                SubworkflowTestUtils.outputSummary(workflow.out.metrics_report, taskId),
                SubworkflowTestUtils.outputSummary(workflow.out.individual_report, taskId),
            ).match()
        }
    }

    test("metrics report fails when the optimal k file is empty") {

        tag "render"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                // empty the optimal k file, as when no value of k could be chosen for the group
                renderReportsInput(SubworkflowTestUtils.dataDir(baseDir), ['optimal-k.txt': { lines -> [] }])
            }
        }

        then {
            assert workflow.failed
            // the metrics report is the only report that reads the optimal k file, so the
            // individual report may or may not finish before the run stops and is not checked
            assert !workflow.trace.succeeded()*.name.any { name -> name.contains('RENDER_METRICS_REPORT') }
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assert output.contains('The optimal k file must contain a single value of k')
        }
    }
}
